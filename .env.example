# Required. A Home Assistant app stores this as a password option.
OPENAI_API_KEY=

# Default German voice. marin was the voice tested on gpt-live-1; an
# unsupported name is rejected by OpenAI when the session starts.
OPENAI_VOICE=juni

# Spoken assistant. These parts are joined into one Live instruction.
ASSISTANT_NAME=Nabu
LANGUAGE=de
EXPRESSION=Warm, friendly, and natural.
SPEAKING_SPEED=normal

# One location entry. A city is enough. A full address, or coordinates, can
# go in the same line when a request needs them.
HOME_LOCATION=
TIMEZONE=Europe/Berlin
UNIT_SYSTEM=metric

# Voice model: how to speak, and when to hand work to the backend.
REPLY_INSTRUCTIONS=Keep answers short and natural. Usually use one or two sentences. Do not use markdown, URLs, or entity IDs.
SMART_HOME_INSTRUCTIONS=Hand a device request to the backend as soon as it is clear. Forward the user's words without adding or removing a room, place, or device name. Do not ask which device they mean before the backend answers. If the result lists several matches, ask one short question.
WEB_SEARCH_INSTRUCTIONS=Ask the backend for current facts such as weather, news, opening hours, and prices. If you already know the answer, say it directly. Speak the backend's result. Do not pretend to look something up.
EXTRA_INSTRUCTIONS=

# Seconds of silence before the Live session closes. Playback keeps it open.
CONVERSATION_IDLE_TIMEOUT=12
# Longer quiet period used only while a web search is running. The normal
# conversation timeout starts again after the search finishes.
WEB_SEARCH_IDLE_TIMEOUT=45
RECONNECT_GRACE_SECONDS=8

ENABLE_WEB_SEARCH=false
# Tool-selection model, from low budget to minimum budget:
# gpt-5.4-mini, gpt-5-mini, gpt-5.4-nano, gpt-5-nano.
# gpt-5.4-nano is the tested balance. WEB_SEARCH_MODEL is still read when
# BACKEND_MODEL is empty.
BACKEND_MODEL=gpt-5.4-nano
# Backend model only. This is the model that calls Home Assistant and web search.
BACKEND_INSTRUCTIONS=For a device request, call the one control function that performs the action, in the same step. Do not call GetLiveContext or any lookup first. Drop German articles (der, die, das, den, dem, des, ein, eine, einen) and the verb. Do not translate the remaining name. Set area only when the user names a room, such as 'im Schlafzimmer', and pass that room unchanged. Never set area or the device name from the home city, timezone, or weather location. If the user describes a kind of device at a spot, such as 'die Lampe am Sofa', pass the spot as the device name and the kind as the domain. If several devices match, return that list and do not guess. Use web search only for current external facts such as weather, news, opening hours, and prices. Never use web search for a device request or for an answer you already know.
WEB_SEARCH_MAX_SENTENCES=2

ENABLE_HOME_ASSISTANT=true
# assist -> /api/mcp/assist (recommended); all -> /api/mcp.
HA_MCP_API=assist
# Optional complete URL override for running outside the Home Assistant add-on.
HA_MCP_URL=
HA_ACCESS_TOKEN=
MCP_TOOL_ALLOWLIST=
# Seconds allowed for one Home Assistant MCP request.
MCP_REQUEST_TIMEOUT=20

WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8080

# Log each spoken user and assistant fragment. Tool calls stay in the log
# while LOG_TOOL_CALLS is true.
LOG_TRANSCRIPTS=true
LOG_TOOL_CALLS=true

# Music Assistant FastMCP plugin. Off until a Music Assistant token is set.
# An empty URL uses http://127.0.0.1:8095/mcp/v1.
ENABLE_MUSIC_ASSISTANT=false
# Similar-tracks mix. Off plays a named station as itself.
ENABLE_RADIO_MIX=false
MA_MCP_URL=
MA_ACCESS_TOKEN=
# Optional player name used when the request names no player.
DEFAULT_MEDIA_PLAYER=
MA_TOOL_ALLOWLIST=

# Required. A Home Assistant app stores this as a password option.
OPENAI_API_KEY=

# Confirmed on gpt-live-1: marin. Other documented Live voices can be tried
# here; an unsupported name is rejected by OpenAI when the session starts.
OPENAI_VOICE=marin

# Spoken assistant. These parts are joined into one Live instruction.
ASSISTANT_NAME=Live
LANGUAGE=en
EXPRESSION=Warm, friendly, and natural.
SPEAKING_SPEED=normal

# One location entry. A city is enough. A full address, or coordinates, can
# go in the same line when a request needs them.
HOME_LOCATION=
TIMEZONE=Europe/Berlin
UNIT_SYSTEM=metric

REPLY_INSTRUCTIONS=Keep answers short and natural. Usually use one or two sentences. Do not use markdown, URLs, or entity IDs.
SMART_HOME_INSTRUCTIONS=Carry out a clear smart-home request immediately. If the device or room is ambiguous, ask one short question.
WEB_SEARCH_INSTRUCTIONS=Use web search only for current facts such as weather, news, opening hours, and prices. Do not search for a smart-home request or for something you can answer directly. Speak the result. Do not pretend to look something up.
EXTRA_INSTRUCTIONS=

# Seconds of silence before the Live session closes. Playback keeps it open.
CONVERSATION_IDLE_TIMEOUT=12
# Longer quiet period used only while a web search is running. The normal
# conversation timeout starts again after the search finishes.
WEB_SEARCH_IDLE_TIMEOUT=45
RECONNECT_GRACE_SECONDS=8

ENABLE_WEB_SEARCH=false
# Responses model that selects tools. gpt-5.4-nano is the cheaper tested
# balance. gpt-5-nano is cheaper still. WEB_SEARCH_MODEL is still read when
# BACKEND_MODEL is empty.
BACKEND_MODEL=gpt-5.4-nano
BACKEND_INSTRUCTIONS=Use web search only when the answer depends on current external information. Never use web search for a smart-home request. For a device request, call one Home Assistant function and return only what that tool result says. Do not claim a device changed unless the tool result confirms it. Answer from general knowledge when no tool is needed.
WEB_SEARCH_MAX_SENTENCES=2

ENABLE_HOME_ASSISTANT=true
# assist -> /api/mcp/assist (recommended); all -> /api/mcp.
HA_MCP_API=assist
# Optional complete URL override for running outside the Home Assistant add-on.
HA_MCP_URL=
HA_ACCESS_TOKEN=
MCP_TOOL_ALLOWLIST=
# Seconds allowed for one Home Assistant MCP request.
MCP_REQUEST_TIMEOUT=20

WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8080

# Log each spoken user and assistant fragment. Tool calls stay in the log
# while LOG_TOOL_CALLS is true.
LOG_TRANSCRIPTS=true
LOG_TOOL_CALLS=true

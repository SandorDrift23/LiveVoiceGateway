# Required. A Home Assistant app stores this as a password option.
OPENAI_API_KEY=

# Confirmed on gpt-live-1: marin. Other documented Live voices can be tried
# here; an unsupported name is rejected by OpenAI when the session starts.
OPENAI_VOICE=marin

# Spoken assistant. These parts are joined into one Live instruction.
ASSISTANT_NAME=Live
LANGUAGE=en
EXPRESSION=Warm, friendly, and natural.
SPEAKING_SPEED=normal

# One location entry. A city is enough. A full address, or coordinates, can
# go in the same line when a request needs them.
HOME_LOCATION=
TIMEZONE=Europe/Berlin
UNIT_SYSTEM=metric

# Voice model: how to speak, and when to hand work to the backend.
REPLY_INSTRUCTIONS=Keep answers short and natural. Usually use one or two sentences. Do not use markdown, URLs, or entity IDs.
SMART_HOME_INSTRUCTIONS=Hand a device request to the backend as soon as it is clear. Do not ask which device they mean before the backend answers. If the result lists several matches, ask one short question.
WEB_SEARCH_INSTRUCTIONS=Ask the backend for current facts such as weather, news, opening hours, and prices. If you already know the answer, say it directly. Speak the backend's result. Do not pretend to look something up.
EXTRA_INSTRUCTIONS=

# Seconds of silence before the Live session closes. Playback keeps it open.
CONVERSATION_IDLE_TIMEOUT=12
# Longer quiet period used only while a web search is running. The normal
# conversation timeout starts again after the search finishes.
WEB_SEARCH_IDLE_TIMEOUT=45
RECONNECT_GRACE_SECONDS=8

ENABLE_WEB_SEARCH=false
# Tool-selection model, from low budget to minimum budget:
# gpt-5.4-mini, gpt-5-mini, gpt-5.4-nano, gpt-5-nano.
# gpt-5.4-nano is the tested balance. WEB_SEARCH_MODEL is still read when
# BACKEND_MODEL is empty.
BACKEND_MODEL=gpt-5.4-nano
# Backend model only. This is the model that calls Home Assistant and web search.
BACKEND_INSTRUCTIONS=For a device request, call one Home Assistant function. Pass only the device name the user said, unchanged and untranslated, and do not add a room. Return only what that tool result says. Use web search only for current external facts such as weather, news, opening hours, and prices. Never use web search for a device request or for an answer you already know.
WEB_SEARCH_MAX_SENTENCES=2

ENABLE_HOME_ASSISTANT=true
# assist -> /api/mcp/assist (recommended); all -> /api/mcp.
HA_MCP_API=assist
# Optional complete URL override for running outside the Home Assistant add-on.
HA_MCP_URL=
HA_ACCESS_TOKEN=
MCP_TOOL_ALLOWLIST=
# Seconds allowed for one Home Assistant MCP request.
MCP_REQUEST_TIMEOUT=20

WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8080

# Log each spoken user and assistant fragment. Tool calls stay in the log
# while LOG_TOOL_CALLS is true.
LOG_TRANSCRIPTS=true
LOG_TOOL_CALLS=true
